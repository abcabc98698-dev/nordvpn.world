---
import PricingToggle from "@/components/ui/PricingToggle.astro";
import Button from "@/components/ui/Button.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import { siteConfig } from "@/config/site";
import { Check, ArrowRight, Sparkles, Zap, Crown, Infinity } from "@lucide/astro";

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
}

const {
  title = "透明透明官方套餐方案，无隐形消费",
  description = "全系支持企业级 IEPL/IPLC 专线与 VLESS 协议。不限在线设备，按需选购，开启高速跨境与生产力体验。",
  showHeader = true,
} = Astro.props;

const plans = [
  {
    name: "致敬斯诺克147永久套餐",
    tierTag: "永久备用神器",
    icon: Infinity,
    monthlyPrice: "¥147",
    yearlyPrice: "¥147",
    monthlyDescription: "一次性购买无忧过期，247GB 永久高速流量，轻度刚需与备用神器。",
    yearlyDescription: "一次性购买无忧过期，247GB 永久高速流量，轻度刚需与备用神器。",
    monthlySuffix: "一次性买断",
    yearlySuffix: "永久版·无忧过期",
    discountBadge: "固定特惠·不打折",
    features: [
      { text: "247GB 永久高速流量（无使用时限，用完为止）", highlight: true },
      { text: "原生稳定节点，单节点最高 2.5Gbps 带宽", highlight: false },
      { text: "香港×20、台湾×5、日本×10、新加坡×10", highlight: false },
      { text: "美国×10、马来×2、英/法/德/土/泰/巴西等", highlight: false },
      { text: "不限制同时在线设备数量", highlight: true },
      { text: "跨境电商 / TikTok 直播 / 社媒投放解锁", highlight: false },
      { text: "办公、邮件、资料查询、微信聊天无压力", highlight: false },
      { text: "自研客户端 + Clash/Shadowrocket 订阅导入", highlight: false },
    ],
    cta: "立即开通永久版",
    popular: false,
  },
  {
    name: "轻量版",
    tierTag: "超高性价比入门",
    icon: Zap,
    monthlyPrice: "¥99",
    yearlyPrice: "¥8.25",
    monthlyDescription: "99元/年 轻量入门，日常办公与学术资料首选。",
    yearlyDescription: "平均仅约 8.25元/月（年付99元折算成本，非普通月付）。",
    monthlySuffix: "/ 年",
    yearlySuffix: "/ 月 (年付折算)",
    discountBadge: "年付 99 元极高性价比",
    notice: "※ 8.25元/月属于年付套餐折算后的平均月成本，并非普通月付价格。",
    features: [
      { text: "69GB / 月 高速流量（每月自动重置）", highlight: true },
      { text: "优质原生稳定节点、抗干扰 VLESS 协议", highlight: false },
      { text: "覆盖港/台/日/新/马/美/德/法/英/土/越", highlight: false },
      { text: "不限制在线设备数量", highlight: true },
      { text: "解锁 ChatGPT / Claude / TikTok", highlight: false },
      { text: "解锁 Netflix / Disney+ 海外流媒体", highlight: false },
      { text: "日常办公、邮件、外贸联络、轻度视频", highlight: false },
      { text: "全天候工单与官方社群技术答疑", highlight: false },
    ],
    cta: "立即选购轻量版",
    popular: false,
  },
  {
    name: "极速版",
    tierTag: "热销旗舰爆款",
    icon: Sparkles,
    monthlyPrice: "¥25",
    yearlyPrice: "¥20",
    monthlyDescription: "25元/月，全球 IPLC 专线，全节点×1倍率，单节点最高2.5Gbps。",
    yearlyDescription: "年付享 8 折特惠（¥240/年，折合仅 ¥20/月），晚高峰超稳。",
    monthlySuffix: "/ 月",
    yearlySuffix: "/ 月 (年付8折)",
    discountBadge: "半年9折 / 年付8折 / 两年75折 / 三年7折",
    features: [
      { text: "168GB / 月 全球 IPLC 专线高速流量", highlight: true },
      { text: "全节点 ×1 无倍率套路，峰值高达 2.5Gbps", highlight: true },
      { text: "企业级 IPLC 国际专线，晚高峰 0 拥堵 0 丢包", highlight: true },
      { text: "覆盖港/台/日/新/马/美/德/法/英/土/越 核心节点", highlight: false },
      { text: "不限设备数量，多端同时在线无门槛", highlight: false },
      { text: "4K/8K Netflix, Disney+, YouTube 秒开极速播放", highlight: false },
      { text: "ChatGPT, Claude 3.5, TikTok 全球直播全解锁", highlight: false },
      { text: "7×24 小时高可用自动化运维保障", highlight: false },
    ],
    cta: "立即开通极速版",
    popular: true,
  },
  {
    name: "定制版",
    tierTag: "企业级高端独享",
    icon: Crown,
    monthlyPrice: "¥680",
    yearlyPrice: "¥680",
    monthlyDescription: "500GB/月，按需独立部署，全 IPLC 专线分配专属原生 IP 与独立带宽。",
    yearlyDescription: "500GB/月，按需独立部署，全 IPLC 专线分配专属原生 IP 与独立带宽。",
    monthlySuffix: "/ 月",
    yearlySuffix: "/ 月 (独立部署)",
    discountBadge: "独享原生IP · 独立带宽 · 一对一确认",
    features: [
      { text: "500GB / 月 独享企业专线流量（可按需扩展）", highlight: true },
      { text: "分配专属原生 IP 与独立带宽，极强隐私隔离", highlight: true },
      { text: "全 IPLC 专线接入，超低时延与企业高可用架构", highlight: true },
      { text: "节点区域按需定制（香港/日本/美国/新加坡等全球）", highlight: false },
      { text: "不限客户端数量，企业团队协同高效顺畅", highlight: false },
      { text: "跨境电商店铺矩阵 / TikTok 直播专属高速通道", highlight: false },
      { text: "海外社媒广告投放 / 跨境远程内网安全互通", highlight: false },
      { text: "7×24 专属 1 对 1 专家级技术与网络运维服务", highlight: true },
    ],
    cta: "预约开通定制版",
    popular: false,
  },
];
---

<section id="pricing" class="pricing-section scroll-mt-24">
  {showHeader && (
    <div class="site-container pt-16 md:pt-20" data-aos="fade-up-xs" data-aos-once="true">
      <SectionHeader title={title} description={description} />
    </div>
  )}

  <!-- Billing Toggle -->
  <div class="site-container mb-10 mt-6" data-aos="fade-up-xs" data-aos-once="true" data-aos-delay="200">
    <PricingToggle monthlyLabel="按月 / 周期计费" yearlyLabel="年付更优惠" saveText="年付最高省 30%" />
  </div>

  <!-- Pricing Cards Grid -->
  <div class="site-container pb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
      {plans.map((plan, i) => (
        <div
          class={`relative flex flex-col justify-between p-6 rounded-2xl border transition-all duration-300 ${
            plan.popular
              ? 'border-primary ring-2 ring-primary/20 shadow-xl lg:-translate-y-2 bg-gradient-to-b from-primary/[0.04] to-bg-secondary dark:to-bg-secondary-dark dark:from-primary/[0.08]'
              : 'border-primary/15 dark:border-neutral-700 bg-bg-secondary dark:bg-bg-secondary-dark hover:border-primary/40 hover:shadow-md'
          }`}
          data-aos="fade-up-sm"
          data-aos-delay={i * 80}
          data-aos-once="true"
        >
          {plan.popular && (
            <div class="popular-badge absolute -top-3.5 left-1/2 -translate-x-1/2 z-10">
              <span class="popular-badge__pill">
                <Sparkles class="w-3.5 h-3.5" stroke-width={2.25} />
                <span class="popular-badge__label font-medium">推荐爆款 · 全球专线</span>
              </span>
            </div>
          )}

          <div>
            <!-- Header Tag -->
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light">
                {plan.tierTag}
              </span>
              <plan.icon class="w-4 h-4 text-primary opacity-80" />
            </div>

            <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-50 mb-2">{plan.name}</h3>

            <p
              class="plan-description text-xs text-neutral-500 dark:text-neutral-400 mb-4 min-h-[36px] leading-relaxed"
              data-monthly={plan.monthlyDescription}
              data-yearly={plan.yearlyDescription}
            >
              {plan.yearlyDescription}
            </p>

            <!-- Price Display with roll animation -->
            <div class="mb-4 pb-4 border-b border-dashed border-primary/15 dark:border-neutral-700">
              <div class="flex items-baseline">
                <span
                  class="plan-price-display text-3xl md:text-4xl font-brand font-bold text-neutral-900 dark:text-neutral-50"
                  data-period-display
                  data-state="yearly"
                >
                  <span class="plan-price-placeholder" aria-hidden="true">{plan.yearlyPrice}</span>
                  <span class="plan-price-mask">
                    <span class="plan-price-track">
                      <span class="plan-price-item" data-period="monthly" aria-hidden="true">{plan.monthlyPrice}</span>
                      <span class="plan-price-item" data-period="yearly">{plan.yearlyPrice}</span>
                    </span>
                  </span>
                </span>
                <span
                  class="plan-suffix text-xs text-neutral-500 dark:text-neutral-400 ml-1.5 font-medium"
                  data-monthly={plan.monthlySuffix}
                  data-yearly={plan.yearlySuffix}
                >
                  {plan.yearlySuffix}
                </span>
              </div>

              <!-- Discount Tag -->
              <div class="mt-2 text-[11px] font-medium text-primary dark:text-primary-light">
                {plan.discountBadge}
              </div>

              {plan.notice && (
                <div class="mt-1 text-[10px] text-amber-600 dark:text-amber-400 leading-tight">
                  {plan.notice}
                </div>
              )}
            </div>

            <!-- Features List -->
            <ul class="space-y-2.5 mb-6 text-xs">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-neutral-600 dark:text-neutral-300 leading-tight">
                  <Check class={`w-4 h-4 flex-shrink-0 mt-0.5 ${feature.highlight ? 'text-primary font-bold' : 'text-emerald-500'}`} stroke-width={2.2} />
                  <span class={feature.highlight ? 'font-medium text-neutral-900 dark:text-neutral-100' : ''}>
                    {feature.text}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA Button -->
          <div class="pt-2">
            <Button
              url={siteConfig.registerUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              type={plan.popular ? "fill" : "solid"}
              className="w-full justify-center text-sm py-2.5"
            >
              <span>{plan.cta}</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </Button>
            <p class="text-[10px] text-center text-neutral-400 dark:text-neutral-500 mt-2">
              官方正品保证 · 专属客服 7×24 在线
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Pricing Bottom Guarantee Notice -->
    <div class="mt-8 max-w-4xl mx-auto p-4 sm:p-5 rounded-2xl border border-dashed border-primary/30 bg-bg-secondary/70 dark:bg-bg-secondary-dark/70 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 text-left leading-relaxed">
        <div class="flex items-center gap-2 font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          官方授权专属注册邀请码自动激活
        </div>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          点击上方任意套餐的“立即开通”将<strong>自动带入专属邀请码</strong>直达官方注册调度通道。如遇手动输入，可直接一键复制。
        </p>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <code class="px-3.5 py-1.5 font-mono font-bold text-sm bg-primary/10 text-primary border border-primary/25 rounded-xl tracking-wider select-all">
          {siteConfig.inviteCode}
        </code>
        <button
          type="button"
          class="invite-copy-btn px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-primary text-white hover:bg-primary-dark transition-all shadow-sm active:scale-95 cursor-pointer"
          data-code={siteConfig.inviteCode}
          title="点击一键复制邀请码"
        >
          <span class="copy-hint">复制邀请码</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function applyPeriod(isYearly: boolean) {
    const period = isYearly ? 'yearly' : 'monthly';

    document.querySelectorAll<HTMLElement>('[data-period-display]').forEach((display) => {
      display.dataset.state = period;
      const targetItem = display.querySelector<HTMLElement>(`.plan-price-item[data-period="${period}"]`);
      const placeholder = display.querySelector<HTMLElement>('.plan-price-placeholder');
      if (targetItem && placeholder) {
        placeholder.textContent = targetItem.textContent;
      }
    });

    document.querySelectorAll<HTMLElement>('.plan-description').forEach((desc) => {
      const text = desc.dataset[period];
      if (text) desc.textContent = text;
    });

    document.querySelectorAll<HTMLElement>('.plan-suffix').forEach((suffix) => {
      const text = suffix.dataset[period];
      if (text) suffix.textContent = text;
    });
  }

  window.addEventListener('pricing-toggle', ((e: CustomEvent) => {
    applyPeriod(Boolean(e.detail?.isYearly));
  }) as EventListener);

  // Initial state matches PricingToggle's default (yearly)
  applyPeriod(true);
</script>

<style>
  .plan-price-display {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
  }

  .plan-price-placeholder {
    visibility: hidden;
  }

  .plan-price-mask {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .plan-price-track {
    display: flex;
    flex-direction: column;
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }

  .plan-price-item {
    display: block;
    line-height: 1;
  }

  .plan-price-display[data-state="monthly"] .plan-price-track {
    transform: translateY(0);
  }

  .plan-price-display[data-state="yearly"] .plan-price-track {
    transform: translateY(-50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .plan-price-track {
      transition: none;
    }
  }

  /* "Most Popular" badge */
  .popular-badge__pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    background: linear-gradient(
      120deg,
      var(--color-primary) 0%,
      color-mix(in oklab, var(--color-primary) 70%, var(--color-accent)) 55%,
      var(--color-accent) 100%
    );
    box-shadow:
      0 6px 18px -6px color-mix(in oklab, var(--color-primary) 65%, transparent),
      0 2px 6px -2px color-mix(in oklab, var(--color-accent) 50%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    isolation: isolate;
    overflow: hidden;
  }

  .popular-badge__pill::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.55),
      rgba(255, 255, 255, 0) 45%,
      rgba(255, 255, 255, 0.25)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }

  .popular-badge__pill::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 70%
    );
    transform: translateX(-120%);
    animation: popular-shine 4.5s ease-in-out 1s infinite;
    pointer-events: none;
  }

  .popular-badge__label {
    position: relative;
    z-index: 1;
    line-height: 1;
  }

  @keyframes popular-shine {
    0%        { transform: translateX(-120%); }
    55%, 100% { transform: translateX(220%); }
  }

  :global(.dark) .popular-badge__pill {
    box-shadow:
      0 8px 22px -6px color-mix(in oklab, var(--color-primary) 80%, transparent),
      0 2px 8px -2px color-mix(in oklab, var(--color-accent) 55%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }
</style>
