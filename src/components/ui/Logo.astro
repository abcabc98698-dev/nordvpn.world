---
// Logo component
---

<a
  href="/"
  class="group relative z-30 flex items-center gap-2.5 transition-transform duration-200 hover:scale-[1.02] flex-shrink-0 whitespace-nowrap select-none"
  aria-label="NordVPN 官方授权品牌首页"
>
  <div class="relative flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-br from-[#2d6dc3] to-[#0f4ca3] text-white shadow-md shadow-primary/20 flex-shrink-0">
    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"></path>
      <path d="m9 12 2 2 4-4"></path>
    </svg>
    <div class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-500 border-2 border-white dark:border-neutral-900"></div>
  </div>
  <div class="flex flex-col flex-shrink-0 whitespace-nowrap">
    <div class="flex items-center gap-1.5 whitespace-nowrap">
      <span class="font-brand text-lg sm:text-xl font-bold tracking-tight text-neutral-900 dark:text-white leading-none whitespace-nowrap">
        NordVPN
      </span>
      <span class="text-[9px] sm:text-[10px] font-semibold uppercase tracking-wider text-primary bg-primary/10 dark:bg-primary/20 px-1.5 py-0.5 rounded whitespace-nowrap">
        WORLD
      </span>
    </div>
    <span class="text-[9px] sm:text-[10px] text-neutral-400 dark:text-neutral-500 font-medium tracking-tight whitespace-nowrap hidden sm:block">
      官方授权品牌落地页
    </span>
  </div>
</a>
