---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import { getCollection } from "astro:content";
import Badge from "@/components/ui/Badge.astro";

const allEntries = await getCollection("changelog");
const entries = allEntries.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title="网络服务更新与升级日志 — NordVPN 官方专线网络"
  description="了解 NordVPN 全球 IEPL/IPLC 企业专线网络、客户端发布、VLESS 架构与节点维护的官方发布日志。"
>
  <section class="site-container my-12">
    <PageHeader
      title="专线服务升级与维护日志"
      description="记录基础设施扩容、专线光缆升级、客户端更新与节点优化的官方进展。"
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <div class="relative">
      <div class="absolute left-4 md:left-6 top-0 bottom-0 w-px bg-neutral-200 dark:bg-neutral-700"></div>

      <div class="space-y-12">
        {entries.map((entry, i) => (
          <div
            class="relative pl-12 md:pl-16"
            data-aos="fade-up-sm"
            data-aos-delay={i * 80}
            data-aos-once="true"
          >
            <div class="absolute left-2.5 md:left-4.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>

            <div class="mb-2 flex items-center gap-3 flex-wrap">
              {entry.data.version && (
                <Badge variant="primary" size="sm">{entry.data.version}</Badge>
              )}
              <time class="text-sm text-neutral-400 dark:text-neutral-500 font-mono">
                {formatDate(entry.data.publishDate)}
              </time>
            </div>

            <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-100 mb-4">
              {entry.data.title}
            </h2>

            <article class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed changelog-content">
              <Fragment set:html={entry.rendered?.html || ""} />
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
