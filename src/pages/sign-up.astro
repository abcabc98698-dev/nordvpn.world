---
import { ArrowRight, ShieldCheck, Zap, Lock, Globe, Check, Copy } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
---

<Layout
  title="注册官方授权账号 — NordVPN 全球专线网络"
  description="立即注册 NordVPN 官方授权专线控制台账号。自动应用专属授权优惠码，尊享 IEPL/IPLC 企业专线、VLESS 协议及不限设备特权。"
>
  <main class="site-container py-12 md:py-20">
    <section class="grid min-h-[calc(100vh-18rem)] items-center gap-8 lg:grid-cols-[minmax(420px,1.05fr)_minmax(0,0.95fr)] max-w-5xl mx-auto">
      <!-- Left: Conversion Gateway Card -->
      <div
        class="mx-auto w-full max-w-md lg:order-first"
        data-aos="fade-up-xs"
        data-aos-once="true"
      >
        <div class="rounded-2xl border border-primary/20 bg-bg-secondary/90 p-6 shadow-xl backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/90 sm:p-8">
          <div class="mb-6">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-primary/10 text-primary">
              <ShieldCheck class="w-3.5 h-3.5" /> 官方授权注册通道
            </span>
            <h1 class="mt-3 font-brand text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">开通 NordVPN 官方专线</h1>
            <p class="mt-2 text-xs sm:text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
              通过官方授权通道注册，系统已为您自动绑定专属授权优惠识别码。
            </p>
          </div>

          <!-- Promo Code Card -->
          <div class="p-4 rounded-xl border border-dashed border-emerald-500/30 bg-emerald-500/[0.04] dark:bg-emerald-500/[0.08] mb-6">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-semibold text-neutral-600 dark:text-neutral-300">
                官方专属注册邀请码（系统自动激活）
              </span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                折算低至 ¥8.25/月
              </span>
            </div>
            <div class="flex items-center justify-between gap-3 bg-white/80 dark:bg-neutral-800/80 p-2.5 rounded-lg border border-emerald-500/20">
              <span class="text-lg font-mono font-extrabold tracking-wider text-emerald-600 dark:text-emerald-400">
                {siteConfig.inviteCode}
              </span>
              <button
                type="button"
                class="invite-copy-btn px-3 py-1 rounded-md text-xs font-semibold bg-emerald-600 text-white hover:bg-emerald-700 transition-all flex items-center gap-1 active:scale-95 cursor-pointer shadow-sm"
                data-code={siteConfig.inviteCode}
              >
                <Copy class="w-3.5 h-3.5" />
                <span class="copy-hint">复制邀请码</span>
              </button>
            </div>
            <p class="mt-2 text-[11px] text-neutral-400 dark:text-neutral-500 leading-normal">
              提示：点击下方按钮跳转时已自动附带该邀请码。若在注册页面遇到手动输入项，可直接粘贴本码享受官方特权。
            </p>
          </div>

          <div class="space-y-4">
            <Button
              url={siteConfig.registerUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              type="fill"
              className="w-full justify-center text-base py-3.5 font-bold shadow-lg"
            >
              <span>进入官方控制台注册 / 开通</span>
              <ArrowRight class="w-4 h-4 ml-1" />
            </Button>

            <p class="text-[11px] text-center text-neutral-400 dark:text-neutral-500">
              点击将直接跳转至 NordVPN 官方统一注册管理系统
            </p>
          </div>

          <div class="mt-6 pt-5 border-t border-dashed border-primary/15 dark:border-neutral-700 text-center">
            <p class="text-xs text-neutral-500 dark:text-neutral-400">
              已有官方账号？
              <a
                href={siteConfig.registerUrl}
                target="_blank"
                rel="nofollow sponsored noopener noreferrer"
                class="font-medium text-primary hover:underline ml-1"
              >
                直接登录控制台
              </a>
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Value Proposition -->
      <div
        class="rounded-2xl border border-primary/15 bg-gradient-to-br from-bg-secondary via-primary/[0.03] to-bg-secondary p-6 sm:p-8 dark:border-neutral-700 dark:bg-bg-secondary-dark"
        data-aos="fade-left-sm"
        data-aos-once="true"
      >
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">WHY NORDVPN</p>
        <h2 class="mt-2 font-brand text-2xl font-bold text-neutral-900 dark:text-neutral-100">
          注册后即享尊贵权益
        </h2>

        <div class="mt-6 space-y-4 text-xs sm:text-sm text-neutral-600 dark:text-neutral-300">
          <div class="flex items-start gap-3">
            <div class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 mt-0.5">
              <Zap class="w-4 h-4" />
            </div>
            <div>
              <strong class="text-neutral-800 dark:text-neutral-100 block">全节点 IEPL / IPLC 专线</strong>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">端到端内网企业专线，晚高峰 0 丢包，单节点最高 2.5Gbps 带宽。</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center flex-shrink-0 mt-0.5">
              <Globe class="w-4 h-4" />
            </div>
            <div>
              <strong class="text-neutral-800 dark:text-neutral-100 block">不限制同时在线设备数量</strong>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">打破单设备限制，手机、电脑、平板与家庭网络全端极速共享。</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center flex-shrink-0 mt-0.5">
              <Lock class="w-4 h-4" />
            </div>
            <div>
              <strong class="text-neutral-800 dark:text-neutral-100 block">自研客户端与通用订阅一键导入</strong>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">提供全平台自研客户端，同时支持 Clash、Shadowrocket、Sing-box 订阅。</p>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-5 border-t border-dashed border-primary/15 dark:border-neutral-700 flex items-center gap-2 text-xs text-neutral-500">
          <Check class="w-4 h-4 text-emerald-500" stroke-width={2.5} />
          <span>官方正品保证 • 7×24 技术客服随时待命</span>
        </div>
      </div>
    </section>
  </main>
</Layout>
