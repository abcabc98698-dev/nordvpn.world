---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";

const POSTS_PER_PAGE = 6;
const currentPage = 1;
---

<Layout
  title="官方知识库与实用专线教程 — NordVPN 全球专线网络"
  description="探索 VLESS 协议原理解析、跨境电商原生 IP 防风控技巧、AI 生产力加速与全平台客户端一键配置指南。"
>
  <section class="relative z-20 container mx-auto my-12 px-7 lg:px-0">
    <PageHeader
      title="官方知识库与网络专线指南"
      description="深入探索 IEPL/IPLC 物理专线架构、VLESS 协议调优、跨境电商直播实战及客户端订阅配置教程。"
    />
  </section>
  <section class="relative z-20 mx-auto my-12 lg:px-0">
    <div class="mt-8">
      <BlogSection
        title=""
        listPage={true}
        pagination={{
          enable: true,
          currentPage: currentPage
        }}
        postsPerPage={POSTS_PER_PAGE}
      />
    </div>
  </section>
</Layout>
